# Copy this file to .env and fill in your own keys.
# .env is gitignored — never commit real credentials.

# Transcription
# Deepgram — default engine for English. https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_MODEL="nova-3"

# Sarvam — Hinglish (transcribes and translates to English). https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_STT_MODEL="saaras:v2.5"

# Whisper — local fallback, no key needed. tiny | base | small | medium | large
WHISPER_MODEL="small"

# Summarization and chat
# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL="gpt-4o-mini"

# Chat reranker — local cross-encoder, no key needed; downloaded once (~90MB).
# RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"

# Optional: browser with a signed-in YouTube session (chrome, edge, firefox, brave)
# YTDLP_BROWSER=chrome
# Alternative when browser-cookie decryption fails: export YouTube cookies in Netscape format.
# Save privately under downloads/ and set this path; it takes precedence over YTDLP_BROWSER.
# YTDLP_COOKIES=downloads/youtube-cookies.txt
