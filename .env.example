# Copy this file to .env and fill in your own keys.
# .env is gitignored — never commit real credentials.

# Transcription
# Deepgram — default engine for English. https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_MODEL="nova-3"

# Sarvam — Hinglish (transcribes and translates to English). https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_STT_MODEL="saaras:v2.5"

# Whisper — local fallback, no key needed. tiny | base | small | medium | large
WHISPER_MODEL="small"
# Offer Whisper in the app. The server image sets this to false: it is slow on a CPU.
# ENABLE_WHISPER=true

# Summarization and chat
# OpenAI. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL="gpt-4o-mini"

# Chat reranker — local cross-encoder, no key needed; downloaded once (~90MB).
# RERANK_MODEL="cross-encoder/ms-marco-MiniLM-L6-v2"

# Optional: browser with a signed-in YouTube session (chrome, edge, firefox, brave)
# YTDLP_BROWSER=chrome
# Alternative when browser-cookie decryption fails: export YouTube cookies in Netscape format.
# Save privately and set this path; it takes precedence over YTDLP_BROWSER.
# YTDLP_COOKIES=data/youtube-cookies.txt

# Sign-in and access
# oidc = Google sign-in (configure .streamlit/secrets.toml, see DEPLOY.md).
# off  = no sign-in, for this computer only; refused unless the app listens on localhost.
#        The server (docker-compose.yml) always forces oidc.
AUTH_MODE=off
# Always admins (comma-separated Google account emails). Admins invite other users in the app.
ADMIN_EMAILS=you@gmail.com
# Optional: regular users allowed without an admin adding them in the app.
# ALLOWED_EMAILS=friend@gmail.com,colleague@gmail.com

# Your domain, for HTTPS on the server (used by docker-compose.yml).
# DOMAIN=video.example.com
# RAM cap for the app container. 3g by default; 1600m on a 2 GB server.
# APP_MEM_LIMIT=1600m

# Where meetings, indexes, users and the audit log are stored.
# DATA_DIR=data

# Limits for regular users (admins have no daily limits). 0 blocks the action.
# Daily limits reset at 00:00 UTC.
# MAX_VIDEO_MINUTES=90
# MAX_UPLOAD_MB=100
# VIDEOS_PER_DAY=5
# AUDIO_MINUTES_PER_DAY=180
# QUESTIONS_PER_DAY=150
# MAX_QUESTION_CHARS=1000
# ANSWER_MAX_TOKENS=800
# Per-minute question limit; applies to admins too.
# QUESTIONS_PER_MINUTE=6
# Videos processed at once, across all users.
# MAX_CONCURRENT_JOBS=2
# New videos pause below this much free disk space.
# MIN_FREE_DISK_GB=2
