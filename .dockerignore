.git
.gitignore
.venv
.venv-eval
venv
env
**/__pycache__
**/*.py[cod]
.pytest_cache
.claude
.vscode
.idea

# Secrets: mounted or passed at run time, never baked into the image.
# "**/" so a copy in any subfolder is excluded too.
**/.env
**/.env.*
.streamlit/secrets.toml
**/*.key
**/*.pem
**/*cookies*.txt

# Data and backups: users' meetings live in the mounted ./data volume, and
# backups/ is written next to this file by deploy/backup.sh.
data
backups
outputs
downloads
vector_db

docs
tests
evals
**/*.pdf
**/*.wav
**/*.mp3
**/*.mp4
**/*.m4a
**/*.webm
