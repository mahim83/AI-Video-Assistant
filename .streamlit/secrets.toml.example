# Google sign-in. Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# Steps to get the client id and secret: DEPLOY.md, "Google sign-in".

[auth]
# Your app's address plus /oauth2callback. Must match the redirect URI
# registered in Google Cloud exactly. For a local test of sign-in:
# "http://localhost:8501/oauth2callback"
redirect_uri = "https://video.example.com/oauth2callback"

# Signs the login cookie. A long random string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = "replace-with-a-long-random-string"

client_id = "1234567890-abc.apps.googleusercontent.com"
client_secret = "GOCSPX-replace-me"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
